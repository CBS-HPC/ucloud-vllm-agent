# Local UCloud credentials; never copy this file into a deployment bundle.
UCLOUD_SERVER=https://cloud.sdu.dk
UCLOUD_TOKEN=
# Required non-secret ID of this exact token, for expiry checks.
# Inspect metadata with `ucloud tokens status`; confirm any ambiguous match.
UCLOUD_TOKEN_ID=
# Exact UUID of the project owning the selected resources and any templates.
UCLOUD_PROJECT=
# Template-ID mode only. For explicit bootstrap mode leave both IDs blank.
UCLOUD_TEMPLATE_JOB_ID=
# CPU preparation template: SSH-capable application, same /work/vllm mount.
# Separate from the nginx serving template.
UCLOUD_PREPARATION_TEMPLATE_JOB_ID=
UCLOUD_SSH_ALIAS=ucloud
UCLOUD_SSH_CONFIG_PATH=
# Optional explicit path to your LOCAL private key; never upload or commit it.
UCLOUD_SSH_IDENTITY_FILE=
UCLOUD_WORK_FOLDER=/work/vllm
# Required for deployment: your reserved hostname or HTTPS /v1 URL.
# Resource setup suggests it but does not rewrite this file.
UCLOUD_PUBLIC_BASE_URL=
UCLOUD_HF_ENV_FILE=/work/vllm/.env
UCLOUD_NGINX_CONFIG=/work/vllm/nginx.conf
# Optional local HF access for gated model metadata.
HF_TOKEN=
# Local verification key. Set the same key in the remote /work/vllm/.env
# alongside HF_TOKEN; the local .env is never uploaded. Bootstrap can explicitly
# provision only these selected serving/HF values through SSH stdin.
VLLM_API_KEY=
