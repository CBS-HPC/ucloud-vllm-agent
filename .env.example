# Local UCloud credentials; never copy this file into a deployment bundle.
UCLOUD_SERVER=https://cloud.sdu.dk
UCLOUD_TOKEN=
UCLOUD_PROJECT=
UCLOUD_TEMPLATE_JOB_ID=
UCLOUD_SSH_CONFIG_PATH=
UCLOUD_WORK_FOLDER=/work/ucloud-vllm
UCLOUD_PUBLIC_BASE_URL=
# Optional local HF access for gated model metadata.
HF_TOKEN=
# Local key used only for endpoint verification. Provision the same key securely
# in the remote secret file; the agent does not upload or print it.
VLLM_API_KEY=
